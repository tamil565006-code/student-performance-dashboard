
body {
    font-family: Arial, sans-serif;
}

.hero {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    text-align: center;
    padding: 35px;
    border-radius: 15px;
}

.hero h1 {
    font-size: 35px;
}

.card {
    background: white;
    padding: 25px;
    margin: 20px 0;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.card h2, .card h3 {
    color: #2563eb;
}

.card p {
    color: #555;
    font-size: 17px;
}

.card li {
    padding: 8px;
}

